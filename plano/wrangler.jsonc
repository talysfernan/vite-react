// Plano Omnichannel — um worker para BR e US (o país vem do cabeçalho x-board / cookie pln_b)
{
  "name": "caos-plano",
  "account_id": "7555b9666c694118eaab1e89c150e74b",
  "main": "site.js",
  "rules": [
    { "type": "Text", "globs": ["**/*.html", "**/*.svg", "**/*.webmanifest", "**/sw.js"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.png"], "fallthrough": true }
  ],
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "plano.meucaos.com", "custom_domain": true }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  "services": [{ "binding": "QUINTAL", "service": "caos-quintal", "entrypoint": "Quintal" }]
  // segredos (SESSION_SECRET, EXPORT_KEY) ficam no Cloudflare: wrangler secret put
}
