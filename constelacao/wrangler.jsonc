// Constelação de ações — um worker para BR e US (o país vem do subdomínio)
{
  "name": "caos-constelacao",
  "account_id": "7555b9666c694118eaab1e89c150e74b",
  "main": "site.js",
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "constelacao-br.meucaos.com", "custom_domain": true },
    { "pattern": "constelacao-us.meucaos.com", "custom_domain": true }
  ],
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  "services": [{ "binding": "QUINTAL", "service": "caos-quintal", "entrypoint": "Quintal" }]
  // segredos (SESSION_SECRET, EXPORT_KEY) ficam no Cloudflare: wrangler secret put
}
